{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:client": "pnpm --filter @orbit/client dev",
    "dev:gateway": "pnpm --filter @orbit/gateway dev",
    "desktop:dev": "PATH=\"$HOME/.cargo/bin:$PATH\" pnpm --filter @orbit/client tauri dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
